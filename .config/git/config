[user]
  name = Rob Isaac
  email = robert.a.isaac@gmail.com
[core]
  pager = delta
[interactive]
  diffFilter = delta --color-only
[delta]
  navigate = true
[merge]
  conflictStyle = zdiff3
[alias]
  st = status --short
  a = add
  c = commit
[push]
  autoSetupRemote = true
[diff]
  mnemonicprefix = true

# SSH signing.
[gpg]
  format = ssh
[user]
  signingkey = $HOME/.ssh/id_ed25519.pub
