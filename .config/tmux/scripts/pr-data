#!/usr/bin/env bash

# Fetch classified PRs for local ~/Code remotes. Prints JSON to stdout:
# {inbox, ready, review, ci, prs:[{categories, repo, number, author, title, updatedAt, path, headRefName}]}
# Counts are derived from prs so the status bar and picker cannot disagree.

set -euo pipefail

scripts_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

graphql_query='
query($reviewQ: String!, $mineQ: String!) {
  review: search(query: $reviewQ, type: ISSUE, first: 100) {
    nodes {
      ... on PullRequest {
        number
        title
        updatedAt
        author { login }
        repository { nameWithOwner }
        headRefName
      }
    }
  }
  mine: search(query: $mineQ, type: ISSUE, first: 100) {
    nodes {
      ... on PullRequest {
        number
        title
        updatedAt
        author { login }
        repository { nameWithOwner }
        headRefName
        isDraft
        reviewDecision
        mergeable
        commits(last: 1) {
          nodes {
            commit { statusCheckRollup { state } }
          }
        }
      }
    }
  }
}
'

classify_jq='
def is_local:
  $paths[.repository.nameWithOwner] != null;

def pr_key:
  "\(.repository.nameWithOwner)#\(.number)";

def mine_category:
  .reviewDecision as $rd
  | .mergeable as $m
  | (.commits.nodes[0].commit.statusCheckRollup.state // "SUCCESS") as $st
  | if $rd == "REVIEW_REQUIRED" or $rd == "CHANGES_REQUESTED" then "review"
    elif $st == "PENDING" or $st == "EXPECTED" then "running"
    elif $st == "FAILURE" or $st == "ERROR" then "ci"
    elif ($st == "SUCCESS") and ($m == "MERGEABLE") then "ready"
    else "ci"
    end;

def as_item($cats):
  .repository.nameWithOwner as $repo
  | {
      categories: $cats,
      repo: $repo,
      number: .number,
      author: (.author.login // ""),
      title: (.title // ""),
      updatedAt: (.updatedAt // ""),
      path: ($paths[$repo] // ""),
      headRefName: (.headRefName // "")
    };

(.data // .) as $d
| ($d.review.nodes // [] | map(select(.number != null and is_local))) as $inbox_nodes
| ($d.mine.nodes // [] | map(select(.number != null and is_local and ((.isDraft // false) | not)))) as $mine_nodes
| reduce $inbox_nodes[] as $pr ({};
    .[$pr | pr_key] = ($pr | as_item(["inbox"]))
  )
| reduce $mine_nodes[] as $pr (.;
    ($pr | pr_key) as $k
    | ($pr | mine_category) as $cat
    | if .[$k] then
        .[$k].categories += [$cat]
      else
        .[$k] = ($pr | as_item([$cat]))
      end
  )
| [.[]]
| sort_by(.updatedAt) | reverse
| {
    prs: .,
    inbox: [.[] | select(.categories | index("inbox"))] | length,
    ready: [.[] | select(.categories | index("ready"))] | length,
    review: [.[] | select(.categories | index("review"))] | length,
    running: [.[] | select(.categories | index("running"))] | length,
    ci: [.[] | select(.categories | index("ci"))] | length
  }
'

empty_json='{"inbox":0,"ready":0,"review":0,"running":0,"ci":0,"prs":[]}'

command -v gh >/dev/null || exit 1
command -v jq >/dev/null || exit 1

paths_json="$(
  "$scripts_dir/local-github-repos" |
    awk -F '\t' 'NF >= 2 && !seen[$1]++ { print $1 "\t" $2 }' |
    jq -R -s -c '
      split("\n")
      | map(select(length > 0))
      | map(split("\t"))
      | map(select(length >= 2))
      | map({key: .[0], value: .[1]})
      | from_entries
    '
)"

if [[ "$paths_json" == "{}" ]]; then
  printf '%s\n' "$empty_json"
  exit 0
fi

response="$(
  gh api graphql \
    -f query="$graphql_query" \
    -F reviewQ='is:pr is:open review-requested:@me' \
    -F mineQ='is:pr is:open author:@me'
)" || exit 1

if jq -e '.errors != null' >/dev/null 2>&1 <<<"$response"; then
  exit 1
fi

jq -c --argjson paths "$paths_json" "$classify_jq" <<<"$response"
