#!/usr/bin/env bash

# Print GitHub origin slugs for git repositories under TMUX_WORKTREE_ROOT
# (default: ~/Code). Each line is: slug<TAB>repo-path

set -euo pipefail

root="${TMUX_WORKTREE_ROOT:-$HOME/Code}"

remote_slug() {
  local url
  url="$(git -C "$1" remote get-url origin 2>/dev/null)" || return 1
  if [[ "$url" =~ ^git@([^:]+):([^/]+)/(.+)$ ]]; then
    echo "${BASH_REMATCH[2]}/${BASH_REMATCH[3]%.git}"
  elif [[ "$url" =~ ^https?://[^/]+/([^/]+)/([^/.]+) ]]; then
    echo "${BASH_REMATCH[1]}/${BASH_REMATCH[2]%.git}"
  else
    return 1
  fi
}

[[ -d "$root" ]] || exit 0

command -v fd >/dev/null || {
  echo "fd is required" >&2
  exit 1
}

while IFS= read -r git_marker; do
  git_marker="${git_marker%/}"
  repo="${git_marker%/.git}"
  slug="$(remote_slug "$repo")" || continue
  printf '%s\t%s\n' "$slug" "$repo"
done < <(
  fd -HI -t d \
    -E node_modules \
    -E .venv \
    -E venv \
    -E vendor \
    -E target \
    -E .cache \
    '^\.git$' "$root"
)
